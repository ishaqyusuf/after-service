{
  "name": "@afterservice/api",
  "private": true,
  "type": "module",
  "exports": {
    "./context": "./src/context.ts",
    "./internal-api": "./src/internal-api.ts",
    "./router": "./src/routers/_app.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "scripts": {
    "dev": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice -- PORTLESS_WILDCARD=1 PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-${API_PORT:-4102}} portless api-afterservice bun --watch src/local.ts",
    "dev:fixed": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice -- bun --watch src/local.ts",
    "dev:prod": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice --mode prod -- bun --watch src/local.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@afterservice/auth": "workspace:*",
    "@afterservice/db": "workspace:*",
    "@afterservice/events": "workspace:*",
    "@afterservice/jobs": "workspace:*",
    "@afterservice/notifications": "workspace:*",
    "@afterservice/utils": "workspace:*",
    "@polar-sh/sdk": "0.34.17",
    "@trigger.dev/sdk": "4.0.1",
    "@trpc/server": "^11.17.0",
    "hono": "^4.0.0",
    "superjson": "^2.2.2",
    "zod": "^4.3.5",
    "@afterservice/assistant": "workspace:*",
    "@afterservice/ai": "workspace:*",
    "ai": "6.0.141"
  },
  "devDependencies": {
    "@afterservice/tsconfig": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
