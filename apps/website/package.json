{
  "name": "@afterservice/website",
  "private": true,
  "scripts": {
    "build": "bun next build --turbopack",
    "dev": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice -- PORTLESS_WILDCARD=1 PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-${SITE_PORT:-4100}} portless afterservice next dev --turbopack",
    "dev:fixed": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice -- next dev --turbopack -p ${SITE_PORT:-4100}",
    "dev:prod": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice --mode prod -- next dev --turbopack -p ${SITE_PORT:-4100}",
    "lint": "biome check .",
    "pwa:verify": "bun ../../scripts/verify-website-pwa.mjs",
    "start": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice --mode prod -- next start -p ${SITE_PORT:-4100}",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@afterservice/api": "workspace:*",
    "@afterservice/events": "workspace:*",
    "@afterservice/plans": "workspace:*",
    "@afterservice/site-nav": "workspace:*",
    "@afterservice/ui": "workspace:*",
    "@afterservice/utils": "workspace:*",
    "@tanstack/react-query": "^5.100.14",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@trpc/tanstack-react-query": "^11.17.0",
    "lucide-react": "^1.17.0",
    "next": "^16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@afterservice/tsconfig": "workspace:*",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.9.3"
  }
}
