{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env", "**/.env.production"],
  "globalEnv": [
    "AFTERSERVICE_AUTH_DEBUG",
    "AFTERSERVICE_ENV_MODE",
    "AFTERSERVICE_PAID_CHECKOUT_ENABLED",
    "API_PROXY_URL",
    "API_PUBLIC_URL",
    "AUTH_SECRET",
    "AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_LOCAL_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_URL",
    "CRON_SECRET",
    "DATABASE_URL",
    "EMAIL_DELIVERY_MODE",
    "EMAIL_FROM_ADDRESS",
    "EMAIL_QA_DOMAIN_ROUTES",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "IS_LAUNCHED",
    "LOGLY_COLLECTOR_URL",
    "LOGLY_ENABLED",
    "LOGLY_PROJECT",
    "LOGLY_PROJECT_KEY",
    "LOGLY_READ_KEY",
    "LOGLY_SERVER_KEY",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_DASHBOARD_URL",
    "NEXT_PUBLIC_LOGLY_ENABLED",
    "NEXT_PUBLIC_LOGLY_ENDPOINT",
    "NEXT_PUBLIC_LOGLY_PROJECT",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_SITE_URL",
    "POLAR_ACCESS_TOKEN",
    "POLAR_ORGANIZATION_ID",
    "POLAR_WEBHOOK_SECRET",
    "QA_ACCELERATOR_ALLOWED_ORIGINS",
    "QA_ACCELERATOR_ENABLED",
    "QA_ACCELERATOR_SECRET",
    "QA_ACCELERATOR_TRUSTED_CLIENT_IP_HEADER",
    "RESEND_API_KEY",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_RELEASE",
    "TEST_EMAIL",
    "TRIGGER_PROFILE",
    "TRIGGER_PROJECT_ID",
    "TRIGGER_SECRET_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "generated/**",
        "build/**",
        "lib/**"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "outputs": ["generated/**"]
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:validate": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:portless": {
      "cache": false,
      "persistent": true
    },
    "format": {},
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  },
  "ui": "tui"
}
