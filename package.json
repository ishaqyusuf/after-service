{
  "name": "after-service",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --env-file=/dev/null ../../local-infra-kit/bin/with-env.ts --profile afterservice --mode prod -- turbo build",
    "clean": "git clean -xdf node_modules .turbo apps/*/.next apps/*/.turbo packages/*/.turbo",
    "dev:prepare": "bun run dev:services",
    "dev": "bun --env-file=/dev/null scripts/dev.ts",
    "dev:services": "bun --env-file=/dev/null ../../local-infra-kit/bin/dev-services.ts --profile afterservice",
    "db:generate": "bun --env-file=/dev/null ../../local-infra-kit/bin/db.ts generate --profile afterservice",
    "db:migrate": "bun --env-file=/dev/null ../../local-infra-kit/bin/db.ts migrate --profile afterservice",
    "db:pull": "bun --env-file=/dev/null ../../local-infra-kit/bin/db.ts pull --profile afterservice",
    "db:push": "bun --env-file=/dev/null ../../local-infra-kit/bin/db.ts push --profile afterservice",
    "db:studio": "bun --env-file=/dev/null ../../local-infra-kit/bin/db.ts studio --profile afterservice",
    "db:validate": "bun --env-file=/dev/null ../../local-infra-kit/bin/with-env.ts --profile afterservice -- prisma validate --config packages/db/prisma.config.ts",
    "env:prod:export": "bun scripts/prod-env.mjs export",
    "env:prod:export:apply": "bun scripts/prod-env.mjs export --apply",
    "env:prod:import": "bun scripts/prod-env.mjs import",
    "email:test": "bun scripts/with-workspace-env.mjs --mode local -- bun scripts/send-test-email.mjs",
    "format": "biome format --write .",
    "jobs:deploy": "bun run --filter @afterservice/jobs deploy",
    "kill:ports": "bun --env-file=/dev/null ../../local-infra-kit/bin/kill-ports.ts --profile afterservice",
    "lint": "biome check package.json turbo.json scripts && turbo lint",
    "qa:credential:issue": "bun --filter @afterservice/db qa:credential:issue",
    "qa:credential:revoke": "bun --filter @afterservice/db qa:credential:revoke",
    "smoke:mvp": "bun --env-file=/dev/null ../../local-infra-kit/bin/with-env.ts --profile afterservice --mode local -- bun scripts/smoke-mvp.mjs",
    "smoke:logly:local": "bun --env-file=/dev/null ../../local-infra-kit/bin/with-env.ts --profile afterservice --mode local -- bun scripts/smoke-logly-local.mjs",
    "start:dashboard:prod": "bun --cwd apps/dashboard ../../scripts/with-workspace-env.mjs --mode production -- bun run next start -p 4101",
    "start:website:prod": "bun --cwd apps/website ../../scripts/with-workspace-env.mjs --mode production -- bun run next start -p 4100",
    "terminal": "bun scripts/terminal.mjs",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-portal": "^1.1.10",
    "framer-motion": "^12.40.0"
  }
}
