{
  "name": "@afterservice/jobs",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "deploy": "bun run prisma.ts && bun run --filter @afterservice/db db:generate && bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice --mode prod -- bun ../../scripts/with-trigger-profile.mjs -- trigger deploy",
    "dev": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice -- bun ../../scripts/with-trigger-profile.mjs -- trigger dev",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@afterservice/db": "workspace:*",
    "@afterservice/notifications": "workspace:*",
    "@ishaqyusuf/logly-server": "^0.2.0",
    "@polar-sh/sdk": "^0.34.0",
    "@trigger.dev/build": "4.0.1",
    "@trigger.dev/sdk": "4.0.1"
  },
  "devDependencies": {
    "@afterservice/tsconfig": "workspace:*",
    "@types/node": "^25.2.3",
    "import-in-the-middle": "1.11.0",
    "trigger.dev": "4.0.1",
    "typescript": "^5.9.3"
  }
}
