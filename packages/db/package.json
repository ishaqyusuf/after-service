{
  "name": "@afterservice/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run db:generate && tsc --noEmit",
    "--build": "prisma generate && tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "lint": "biome check .",
    "qa:credential:issue": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice -- bun scripts/issue-qa-tester-credential.ts",
    "qa:credential:revoke": "bun --env-file=/dev/null ../../../../local-infra-kit/bin/with-env.ts --profile afterservice -- bun scripts/revoke-qa-tester-credential.ts",
    "typecheck": "bun run db:generate && tsc --noEmit"
  },
  "devDependencies": {
    "@afterservice/tsconfig": "workspace:*",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0"
  }
}
