# Loaded after .env for the isolated preview profile.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/afterservice-preview?sslmode=require
AFTERSERVICE_ENV_MODE=preview
EMAIL_QA_DOMAIN_ROUTES={"afterservice.qa.test":"qa-inbox@example.com"}
QA_ACCELERATOR_ENABLED=true
QA_ACCELERATOR_ALLOWED_ORIGINS=https://preview-dashboard.afterservice.app
QA_ACCELERATOR_SECRET=replace-with-at-least-32-random-characters
# Set only when the edge proxy overwrites this header.
QA_ACCELERATOR_TRUSTED_CLIENT_IP_HEADER=x-real-ip
